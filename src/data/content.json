 "grammar1a": [
  {
   "title": "Topic Particle (은/는)",
   "explanation": "Marks the topic of the sentence.",
   "examples": [
    "저는 학생이에요. (I am a student.)",
    "이것은 책이에요. (This is a book.)"
   ]
  },
  {
   "title": "Subject Particle (이/가)",
   "explanation": "Marks the subject of the sentence.",
   "examples": [
    "비가 와요. (It is raining.)",
    "친구가 가요. (My friend is going.)"
   ]
  },
  {
   "title": "Object Particle (을/를)",
   "explanation": "Marks the object of the verb.",
   "examples": [
    "밥을 먹어요. (I eat rice.)",
    "영화를 봐요. (I watch a movie.)"
   ]
  },
  {
   "title": "Location/Time Particle (~에)",
   "explanation": "Indicates time or static location.",
   "examples": [
    "학교에 가요. (I go to school.)",
    "3시에 만나요. (Let's meet at 3.)"
   ]
  },
  {
   "title": "Action Location Particle (~에서)",
   "explanation": "Indicates where an action takes place.",
   "examples": [
    "도서관에서 공부해요. (I study at the library.)",
    "집에서 자요. (I sleep at home.)"
   ]
  },
  {
   "title": "Also/Too (도)",
   "explanation": "Means 'also' or 'too'.",
   "examples": [
    "저도 학생이에요. (I am also a student.)",
    "사과도 있어요. (There are apples too.)"
   ]
  },
  {
   "title": "Direction/Means ((으)로)",
   "explanation": "Indicates direction or means/method.",
   "examples": [
    "버스로 가요. (I go by bus.)",
    "오른쪽으로 가세요. (Go to the right.)"
   ]
  },
  {
   "title": "From-To (부터-까지)",
   "explanation": "Indicates a range of time.",
   "examples": [
    "9시부터 6시까지 일해요. (I work from 9 to 6.)",
    "월요일부터 금요일까지 (From Monday to Friday)"
   ]
  },
  {
   "title": "From-To (에서-까지)",
   "explanation": "Indicates a range of location.",
   "examples": [
    "집에서 학교까지 걸어요. (I walk from home to school.)",
    "서울에서 부산까지 (From Seoul to Busan)"
   ]
  }
 ],
 "grammar1b": [
